# Backblaze B2 (required)
# The API writes manifests and derivatives with these, and hands them to LiveKit
# Egress per recording request so Egress can upload the audio itself.
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# The region in your bucket's S3 endpoint, e.g. s3.<region>.backblazeb2.com.
# The endpoint itself is derived from it, so there is no endpoint variable.
B2_REGION=your-b2-region

# Optional: public base URL for objects, when the bucket is public.
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.your-b2-region.backblazeb2.com

# LiveKit (required). Local dev values for the Compose stack only; pick your own.
# The server, Egress, the agent and the API all read this pair. The secret must
# be at least 32 characters.
LIVEKIT_API_KEY=devkey-change-me
LIVEKIT_API_SECRET=dev-secret-change-me-at-least-32-chars

# Optional LiveKit endpoints (defaults shown).
# LIVEKIT_URL=ws://livekit:7880
# LIVEKIT_PUBLIC_URL=ws://localhost:7880

# Set by docker-compose.yml; override only when running outside Compose.
# SESSION_SCRIPTS_DIR=services/agent/scripts
# AGENT_NAME=session-archive-test-agent

# Optional: prefix for every key this app writes (make test uses e2e/<run-id>/).
# ARCHIVE_PREFIX=

# Optional transcription and evaluation settings (defaults shown).
# WHISPER_MODEL=tiny.en
# WHISPER_DEVICE=auto
# EVAL_MAX_WER=0.5

# Optional retention per session class, in days (hold is never removed).
# RETENTION_DAYS_DEBUG=1
# RETENTION_DAYS_STANDARD=30
# RETENTION_DAYS_TRAINING=365

# Frontend -> API base URL. Defaults to http://localhost:8000 (the Compose api
# service). Next.js inlines it at build time.
# NEXT_PUBLIC_API_URL=http://localhost:8000
